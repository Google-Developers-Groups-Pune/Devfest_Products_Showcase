{
  "name": "prompt-heist-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt Heist game orchestration backend: REST API, Socket.IO realtime gateway, round timer, scoring pipeline and AI agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-prompt-heist \"vitest run\"",
    "seed:controller": "node --env-file-if-exists=.env --import tsx scripts/seed-controller.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "csv-stringify": "^6.9.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^14.5.1",
    "jose": "^6.2.18",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "firebase-tools": "^15.37.0",
    "globals": "^17.14.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
