# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Comma-separated browser origins allowed for Socket.IO (frontend dev server).
CORS_ORIGINS=http://localhost:5000

# GCP (BE-38). Region asia-south1 per BE-38.
GCP_PROJECT_ID=
GCP_REGION=asia-south1
VERTEX_LOCATION=
STORAGE_BUCKET=

# Gemini model IDs, pinned on Day 1 by BE-38. Never hard-code them.
MODEL_TEXT=
MODEL_GUARD=
IMAGE_MODEL=
IMAGE_MODEL_FALLBACK=
# Optional art style for treasure images (BE-35). Empty uses the default in src/agents/image-agent.ts.
IMAGE_STYLE_PREFIX=

# Domain is config only (BE-38, D24).
APP_DOMAIN=
JOIN_URL=

# Controller token signing key (BE-05). From Secret Manager on Cloud Run. Min 32 chars.
JWT_SECRET=

# Local Firestore emulator (set automatically by `npm run test:emulator`).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
